FROM node:22.23.4-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make python3 openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global --no-fund --no-audit pnpm@10.6.1
WORKDIR /app
COPY . .
ARG SOURCE_REVISION
ARG NEXT_PUBLIC_BACKEND_URL=https://postiz.qanda.ng/api
ARG NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
ARG STORAGE_PROVIDER=local
ENV NEXT_TELEMETRY_DISABLED=1
RUN test -n "$SOURCE_REVISION" && python3 scripts/deployment/prepare-release-source.py "$SOURCE_REVISION"
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm rebuild bcrypt \
    && pnpm exec prisma generate --schema libraries/nestjs-libraries/src/database/prisma/schema.prisma
RUN NODE_OPTIONS=--max-old-space-size=6144 pnpm --filter ./apps/frontend run build --webpack
RUN NODE_OPTIONS=--max-old-space-size=6144 pnpm --filter ./apps/backend run build
RUN NODE_OPTIONS=--max-old-space-size=6144 pnpm --filter ./apps/orchestrator run build
RUN rm -rf apps/frontend/.next/cache

FROM node:22.23.4-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends nginx openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system www \
    && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
    && mkdir -p /www && chown -R www:www /www /var/lib/nginx
WORKDIR /app
COPY --from=build /app /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/toluw/qanda-social-manager" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.licenses="AGPL-3.0"
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 5000
CMD ["bash", "/app/scripts/deployment/start-release.sh"]
